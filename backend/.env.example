APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost/project/backend/public
APP_KEY=replace-with-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jassnet_billing
